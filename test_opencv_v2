import cv2
import numpy as np
import json

def extract_result_window(img):
    h, w, _ = img.shape
    return img[int(h*0.30):int(h*0.70),
               int(w*0.35):int(w*0.65)]

def detect_lines_gray(result_roi):
    gray = cv2.cvtColor(result_roi, cv2.COLOR_BGR2GRAY)

    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
    enhanced = clahe.apply(gray)

    edges = cv2.Canny(enhanced, 50, 150)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 25))
    vertical = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)

    vertical_sum = np.sum(vertical > 0, axis=0)
    threshold = result_roi.shape[0] * 0.15

    peaks = np.where(vertical_sum > threshold)[0]
    if len(peaks) == 0:
        return 0

    lines = 1
    for i in range(1, len(peaks)):
        if peaks[i] - peaks[i-1] > 12:
            lines += 1

    return min(lines, 2)


def analyze_testkit(image_path):

    print(f"image_path: {image_path}")

    img = cv2.imread(image_path)
    window = extract_result_window(img)

    line_cnt = detect_lines_final(window)

    if line_cnt == 2:
        c, t = "OK", "OK"
    elif line_cnt == 1:
        c, t = "OK", "NO"
    else:
        c, t = "NO", "NO"

    return {
        "result": {
            "C": c,
            "T": t,
            "LineCnt": line_cnt
        }
    }


def find_vertical_candidates(result_roi):
    gray = cv2.cvtColor(result_roi, cv2.COLOR_BGR2GRAY)

    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
    enhanced = clahe.apply(gray)

    edges = cv2.Canny(enhanced, 40, 120)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 20))
    vertical = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(
        vertical, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
    )

    h, w = result_roi.shape[:2]
    candidates = []

    for cnt in contours:
        x, y, cw, ch = cv2.boundingRect(cnt)
        if ch > h * 0.20 and cw < w * 0.20:
            candidates.append((x, y, cw, ch))

    return candidates


def verify_real_line(result_roi, bbox):
    x, y, w, h = bbox
    roi = result_roi[y:y+h, x:x+w]

    score = 0

    # ① 최소 두께 (완화)
    if w >= 2:
        score += 1

    # ② 명도 대비
    gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    if np.std(gray) > 4:
        score += 1

    # ③ 색상 존재 (매우 완화)
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    color_mask = cv2.inRange(
        hsv,
        np.array([0, 10, 10]),
        np.array([180, 255, 255])
    )
    color_ratio = np.sum(color_mask > 0) / (roi.shape[0] * roi.shape[1])
    if color_ratio > 0.25:
        score += 1

    # 👉 3개 중 2개 이상 만족하면 진짜 라인
    return score >= 2


def detect_lines_robust(result_roi):
    candidates = find_vertical_candidates(result_roi)

    valid_lines = []
    for bbox in candidates:
        if verify_real_line(result_roi, bbox):
            valid_lines.append(bbox)

    # 좌표 기준 그룹핑 (겹침 제거)
    valid_lines.sort(key=lambda b: b[0])
    final = []

    for b in valid_lines:
        if not final or abs(b[0] - final[-1][0]) > 12:
            final.append(b)

    return min(len(final), 2)

def detect_lines_final(result_roi):
    candidates = find_vertical_candidates(result_roi)

    valid = []
    for bbox in candidates:
        if verify_real_line(result_roi, bbox):
            valid.append(bbox)

    # 좌표 기준 그룹핑
    valid.sort(key=lambda b: b[0])
    lines = []

    for b in valid:
        if not lines or abs(b[0] - lines[-1][0]) > 12:
            lines.append(b)

    return min(len(lines), 2)



