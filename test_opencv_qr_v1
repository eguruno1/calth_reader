import cv2
import numpy as np
import json
import math


# ============================================================
# 1. QR 코드 검출 및 텍스트 추출
# ============================================================
def detect_qr_code(img):
    """
    실사 키트 QR 전용 고신뢰 인식 함수
    """
    qr = cv2.QRCodeDetector()
    h, w = img.shape[:2]

    # 1️⃣ QR이 존재할 수밖에 없는 상단 영역만 사용
    roi = img[int(h * 0.02):int(h * 0.30),
              int(w * 0.30):int(w * 0.70)]

    # 2️⃣ ROI 확대 (★ 핵심 ★)
    scale = 3.5
    roi_up = cv2.resize(
        roi, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC
    )

    # 3️⃣ 대비 강화
    gray = cv2.cvtColor(roi_up, cv2.COLOR_BGR2GRAY)
    clahe = cv2.createCLAHE(3.0, (8, 8))
    enhanced = clahe.apply(gray)

    # 4️⃣ 이진화
    _, binary = cv2.threshold(
        enhanced, 0, 255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )

    # 5️⃣ QR 인식 시도
    data, bbox, _ = qr.detectAndDecode(binary)

    if bbox is not None and data:
        # 좌표를 원본 이미지 기준으로 환산
        bbox = bbox / scale
        bbox[:, :, 0] += int(w * 0.30)
        bbox[:, :, 1] += int(h * 0.02)

        return {
            "exists": True,
            "text": data,
            "bbox": bbox.astype(int)
        }

    return {
        "exists": False,
        "text": None,
        "bbox": None
    }




# ============================================================
# 2. QR 위치 기준 자동 회전 보정
# ============================================================
def rotate_image_by_qr(img, qr_bbox):
    """
    QR 코드의 기울기를 계산하여
    이미지 전체를 자동으로 회전 보정한다.
    """
    pts = qr_bbox[0]

    # QR 상단 변 벡터
    dx = pts[1][0] - pts[0][0]
    dy = pts[1][1] - pts[0][1]

    angle = math.degrees(math.atan2(dy, dx))

    h, w = img.shape[:2]
    center = (w // 2, h // 2)

    M = cv2.getRotationMatrix2D(center, angle, 1.0)
    rotated = cv2.warpAffine(
        img, M, (w, h),
        flags=cv2.INTER_LINEAR,
        borderMode=cv2.BORDER_REPLICATE
    )
    return rotated


# ============================================================
# 3. QR 영역 마스킹 (라인 검출 안정화)
# ============================================================
def mask_qr_region(img, qr_bbox):
    """
    QR 코드 영역을 흰색으로 마스킹하여
    라인 검출 시 간섭을 제거한다.
    """
    masked = img.copy()
    pts = qr_bbox[0]

    x_min = np.min(pts[:, 0])
    x_max = np.max(pts[:, 0])
    y_min = np.min(pts[:, 1])
    y_max = np.max(pts[:, 1])

    cv2.rectangle(
        masked,
        (x_min, y_min),
        (x_max, y_max),
        (255, 255, 255),
        thickness=-1
    )
    return masked


# ============================================================
# 4. 결과창 ROI 자동 추출
# ============================================================
def extract_result_window(img):
    """
    키트 전체 이미지에서
    반응라인이 위치한 중앙 영역을 자동 ROI로 추출
    """
    h, w, _ = img.shape
    return img[int(h * 0.30):int(h * 0.70),
               int(w * 0.35):int(w * 0.65)]


# ============================================================
# 5. 세로 라인 후보 탐색
# ============================================================
def find_vertical_candidates(result_roi):
    """
    세로 방향 구조물을 찾아
    반응라인 후보 bbox 리스트를 반환
    """
    gray = cv2.cvtColor(result_roi, cv2.COLOR_BGR2GRAY)

    clahe = cv2.createCLAHE(2.0, (8, 8))
    enhanced = clahe.apply(gray)

    edges = cv2.Canny(enhanced, 40, 120)

    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 20))
    vertical = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(
        vertical, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
    )

    h, w = result_roi.shape[:2]
    candidates = []

    for cnt in contours:
        x, y, cw, ch = cv2.boundingRect(cnt)
        if ch > h * 0.20 and cw < w * 0.20:
            candidates.append((x, y, cw, ch))

    return candidates


# ============================================================
# 6. 실제 반응라인 검증
# ============================================================
def verify_real_line(result_roi, bbox):
    """
    후보 bbox가 실제 반응라인인지 점수 기반으로 검증
    """
    x, y, w, h = bbox
    roi = result_roi[y:y + h, x:x + w]

    score = 0

    # ① 최소 두께
    if w >= 2:
        score += 1

    # ② 명암 대비
    gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    if np.std(gray) > 4:
        score += 1

    # ③ 색상 존재
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    color_mask = cv2.inRange(
        hsv,
        np.array([0, 20, 20]),
        np.array([180, 255, 255])
    )
    color_ratio = np.sum(color_mask > 0) / (roi.shape[0] * roi.shape[1])

    if color_ratio > 0.25:
        score += 1

    return score >= 2


# ============================================================
# 7. 최종 라인 검출
# ============================================================
def detect_lines_final(result_roi):
    """
    반응라인 최종 검출 함수
    - 최대 2라인까지 검출
    """
    candidates = find_vertical_candidates(result_roi)

    valid = []
    for bbox in candidates:
        if verify_real_line(result_roi, bbox):
            valid.append(bbox)

    valid.sort(key=lambda b: b[0])

    lines = []
    for b in valid:
        if not lines or abs(b[0] - lines[-1][0]) > 12:
            lines.append(b)

    return min(len(lines), 2)


# ============================================================
# 8. 전체 분석 파이프라인
# ============================================================
def analyze_testkit(image_path):
    """
    진단키트 이미지 전체 분석
    - QR 검출
    - 회전 보정
    - QR 마스킹
    - 라인 검출
    - JSON 결과 반환
    """
    print(f"image_path: {image_path}")
    img = cv2.imread(image_path)

    qr = detect_qr_code(img)

    # QR 기준 회전 보정
    if qr["exists"]:
        img = rotate_image_by_qr(img, qr["bbox"])
        img = mask_qr_region(img, qr["bbox"])

    result_window = extract_result_window(img)
    line_cnt = detect_lines_final(result_window)

    if line_cnt == 2:
        c, t = "OK", "OK"
    elif line_cnt == 1:
        c, t = "OK", "NO"
    else:
        c, t = "NO", "NO"

    return {
        "result": {
            "C": c,
            "T": t,
            "LineCnt": line_cnt
        },
        "qr": {
            "exists": qr["exists"],
            "text": qr["text"]
        }
    }


# ============================================================
# 9. 실행 테스트
# ============================================================
if __name__ == "__main__":
    result = analyze_testkit("./images/kit_bench_2Line_over.jpeg")
    print(json.dumps(result, indent=2, ensure_ascii=False))

